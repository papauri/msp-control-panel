# Copy to .env (never commit .env). Keep this file outside public/ (it is, by layout).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Absolute path to the ECDSA P-256 private key made by scripts/make-keys.php.
# Must be OUTSIDE public/ and readable only by the web user (chmod 600).
PRIVATE_KEY_PATH=/home/CPANELUSER/msp-control-panel/keys/licence-private.pem

# Public URL of the panel (https only in production).
APP_URL=https://licence.example.com

# Session cookie name.
SESSION_NAME=mspcp_sid

# Optional: timezone used for "today" when computing status (default Africa/Blantyre).
APP_TZ=Africa/Blantyre
