# Copy to .env (never commit .env). Keep this file outside public/ (it is, by layout).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Absolute path to the ECDSA P-256 private key made by scripts/make-keys.php.
# Must be OUTSIDE public/ and readable only by the web user (chmod 600).
PRIVATE_KEY_PATH=/home/CPANELUSER/msp-control-panel/keys/licence-private.pem

# Public URL of the panel (https only in production).
APP_URL=https://licence.example.com

# Session cookie name.
SESSION_NAME=mspcp_sid

# Optional: timezone used for "today" when computing status (default Africa/Blantyre).
APP_TZ=Africa/Blantyre

# Email (sales and billing). Fill these in on the panel's own server.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=info@promanaged-it.com
SMTP_PASS=
SMTP_SECURE=ssl
MAIL_FROM_EMAIL=info@promanaged-it.com
MAIL_FROM_NAME=ProManaged IT
# 1 = when SMTP_HOST is empty, borrow the mail settings of the hotel database the panel shares (temporary set-up only).
MAIL_SETTINGS_FROM_DB=0
# While testing: EVERY email goes only to this address. Remove the line to email clients for real.
#MAIL_TEST_TO=you@example.com
